{
  "experiment": "e02_stock_baseline",
  "description": "What stock tpu-inference does when a batch crosses a request-ladder edge. Decides whether the admission contribution exists.",
  "model": "Qwen/Qwen3-4B",
  "tpu_type": "v5litepod-4",
  "warmup_log_path": "/tmp/vllm_warmup.log",
  "controlled": {
    "enable_prefix_caching": false,
    "enable_chunked_prefill": true,
    "max_num_batched_tokens": 8192,
    "tensor_parallel_size": 4,
    "speculative_model": null,
    "kv_cache_dtype": "auto",
    "VLLM_TPU_BUCKET_PADDING_GAP": "",
    "max_model_len": 8192,
    "XLA_FLAGS": ""
  },
  "request_ladder": [
    8,
    16,
    32,
    64,
    128,
    256
  ],
  "edge": 8,
  "prompt_len": 512,
  "output_len": 8,
  "repeats": 3
}
