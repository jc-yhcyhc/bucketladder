{
  "experiment": "e30_policy_sweep",
  "description": "Admission policy sweep on matched traces. Baseline is stock (=promote).",
  "model": "meta-llama/Llama-3.1-8B-Instruct",
  "tpu_type": "v5litepod-4",
  "warmup_log_path": "/tmp/vllm_warmup.log",
  "controlled": {
    "enable_prefix_caching": false,
    "enable_chunked_prefill": true,
    "max_num_batched_tokens": 8192,
    "tensor_parallel_size": 4,
    "speculative_model": null,
    "kv_cache_dtype": "auto",
    "VLLM_TPU_BUCKET_PADDING_GAP": "",
    "max_model_len": 8192,
    "XLA_FLAGS": ""
  },
  "rates_hz": [
    10,
    25,
    40,
    55,
    70,
    90
  ],
  "seeds": 30,
  "n_requests": 400,
  "prompt_len": 512,
  "policies": [
    "promote",
    "wait",
    "hybrid",
    "downshift",
    "oracle"
  ],
  "latency_weight": 1.0,
  "max_wait_s": 0.5,
  "note_rates": "Centred on the measured stock capacity (~49 req/s at prompt_len=512, from the fitted cost model). Spans under-load, knee and over-load, because the promote-vs-wait crossover is a load-dependent question."
}
