# Shared configuration for infra/*.sh. Source, don't execute.
# Every value here is overridable from the environment:  ZONE=us-central1-a ./create_tpu.sh

# --- What to create ---------------------------------------------------------
: "${TPU_NAME:=bucketladder-v5e4}"
# GCE-native TPU path ("Lightweight Exploration" in the console). This project's
# GCP console does not offer the legacy Cloud TPU API "Create TPU node" page, so
# a TPU here is an ordinary Compute Engine instance with a TPU machine type.
# ct5lp-hightpu-4t = v5e, 4 chips, single host, 112 vCPU / 192 GB. TP=4 fixed.
: "${MACHINE_TYPE:=ct5lp-hightpu-4t}"
# Accelerator image supporting v5e/v5p/v6e. NOT the same as the Cloud TPU API's
# "runtime version" (v2-alpha-tpuv5-lite) — that concept does not exist here.
: "${IMAGE_FAMILY:=ubuntu-accel-2204-amd64-tpu-v5e-v5p-v6e}"
: "${IMAGE_PROJECT:=ubuntu-os-accelerator-images}"
: "${BOOT_DISK_SIZE:=200GB}"

# --- Where ------------------------------------------------------------------
# MUST match the zone your v5e quota was approved in. Quota for one generation
# in one zone does not grant another. See PREREQUISITES in create_tpu.sh.
: "${ZONE:=us-central1-a}"
: "${PROJECT:=$(gcloud config get-value project 2>/dev/null)}"

# --- Spot vs on-demand ------------------------------------------------------
# Spot is ~$1.40/hr vs ~$4.80/hr on-demand for a v5litepod-4.
# Rule from plan_v4.md: spot for re-runnable work, on-demand for anything kept.
# A preempted holdout run is a corrupted holdout run.
: "${SPOT:=false}"

# --- Cost bookkeeping -------------------------------------------------------
# The tracked quantity is BILLED VM-HOURS, not benchmark-hours. A TPU VM bills
# while it exists, not while it computes. Headroom to the $1000 ceiling is
# roughly one forgotten VM-week.
: "${PRICE_PER_CHIP_HOUR_ONDEMAND:=1.20}"
: "${PRICE_PER_CHIP_HOUR_SPOT:=0.35}"
: "${CHIPS:=4}"

# --- Where state lives ------------------------------------------------------
# Never leave results on the VM disk; the VM is deleted at the end of every
# session and re-created from scratch.
: "${GCS_BUCKET:=gs://${PROJECT}-bucketladder}"

# --- Model / serving --------------------------------------------------------
# Llama-3.1-8B-Instruct is on tpu-inference's fully-tested list; Gemma-3-4b is
# not (notes/prior_art.md, incidental finding). Gated repo — request access
# BEFORE provisioning, it is a common multi-hour stall.
: "${MODEL:=meta-llama/Llama-3.1-8B-Instruct}"
: "${TPU_INFERENCE_VERSION:=}"   # empty = latest; pin before any real run
