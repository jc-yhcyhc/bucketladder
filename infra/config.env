# Shared configuration for infra/*.sh. Source, don't execute.
# Every value here is overridable from the environment:  ZONE=us-central1-a ./create_tpu.sh

# --- What to create ---------------------------------------------------------
: "${TPU_NAME:=bucketladder-tpu}"
# --- Which provisioning surface -------------------------------------------
# See infra/_paths.sh. Two independent surfaces with separate quota:
#   tpu-api  Cloud TPU API. THIS IS THE DEFAULT — it is where our quota is
#            unambiguous (TPU_LITE_PODSLICE_V5 = 16, on-demand and preemptible),
#            and it offers v5litepod-4 even though the console's instance flow
#            does not list CT5LP at all. tpu.googleapis.com is enabled.
#   gce      Console "Lightweight Exploration". Fallback if the API path is
#            refused; v6e there, since CT5LP is not offered.
: "${PROVISION_PATH:=tpu-api}"

# --- tpu-api path ---------------------------------------------------------
# v5e, 4 chips, single host. TP=4. The original plan, and the configuration our
# quota metric names exactly.
: "${ACCELERATOR_TYPE:=v5litepod-4}"
: "${RUNTIME_VERSION:=v2-alpha-tpuv5-lite}"

# --- gce path (fallback) --------------------------------------------------
# One v6e chip: 32 GB HBM fits Llama-3.1-8B without tensor parallelism, so TP=1.
: "${MACHINE_TYPE:=ct6e-standard-1t}"
: "${IMAGE_FAMILY:=ubuntu-accel-2204-amd64-tpu-v5e-v5p-v6e}"
: "${IMAGE_PROJECT:=ubuntu-os-accelerator-images}"
: "${BOOT_DISK_SIZE:=200GB}"

# --- Where ------------------------------------------------------------------
# MUST match the zone your v5e quota was approved in. Quota for one generation
# in one zone does not grant another. See PREREQUISITES in create_tpu.sh.
: "${ZONE:=us-central1-a}"
# Zones teardown_tpu.sh sweeps before it will report "nothing billing". The
# default ZONE is only ever a guess: v5e capacity moves, and a session takes
# whichever zone had chips that day. Any zone this project has ever provisioned
# in belongs here, or a teardown run against the wrong ZONE exits 0 while the
# TPU bills.
#
# 2026-08-17: extended to every zone the project holds v5e podslice quota in,
# not just the ones it has used. The hunt widened to europe-west4 and
# asia-northeast1 after a US-wide capacity shortage, and a sweep list that
# lags the provision list is the false all-clear this comment already warns
# about -- it just fails in a zone nobody thought to name. us-east1-d stays
# because a slice was provisioned there once, though quota there now reads 0.
: "${TEARDOWN_SWEEP_ZONES:=us-central1-a us-central1-b us-central1-c us-west4-a us-west1-c us-east1-d us-east5-a us-east5-b us-east5-c us-south1-a europe-west4-a europe-west4-b europe-west4-c asia-northeast1-a asia-northeast1-b asia-northeast1-c}"
: "${PROJECT:=$(gcloud config get-value project 2>/dev/null)}"

# --- Spot vs on-demand ------------------------------------------------------
# Spot is ~$1.40/hr vs ~$4.80/hr on-demand for a v5litepod-4.
# Rule from plan_v4.md: spot for re-runnable work, on-demand for anything kept.
# A preempted holdout run is a corrupted holdout run.
: "${SPOT:=false}"

# TP and per-chip price follow the ACCELERATOR TYPE, not just which API
# surface it's requested through. Found live, 2026-09-01: this used to key
# price purely on PROVISION_PATH (tpu-api vs gce), which was silently
# correct only because tpu-api had only ever meant v5litepod-4 in this
# project. The moment ACCELERATOR_TYPE=v6e-4 was requested via tpu-api (a
# genuine 4-chip v6e podslice, same surface as v5e, discovered this session),
# it displayed v5e's $1.20/chip-hr instead of v6e's $2.70 -- a >2x cost
# understatement for a project that tracks billed-VM-hours against a hard
# ceiling. Chip count is now parsed from the accelerator type's own suffix
# rather than hardcoded, so a different podslice size is not silently
# mispriced either.
if [[ "${PROVISION_PATH:-tpu-api}" == "tpu-api" ]]; then
  _accel="${ACCELERATOR_TYPE:-v5litepod-4}"
  : "${CHIPS:=${_accel##*-}}"
  : "${TP_SIZE:=$CHIPS}"
  case "$_accel" in
    v6e-*)
      : "${PRICE_PER_CHIP_HOUR_ONDEMAND:=2.70}"; : "${PRICE_PER_CHIP_HOUR_SPOT:=0.81}" ;;
    v5litepod-*|v5p-*)
      : "${PRICE_PER_CHIP_HOUR_ONDEMAND:=1.20}"; : "${PRICE_PER_CHIP_HOUR_SPOT:=0.35}" ;;
    *)
      echo "[config.env] WARNING: no known price for accelerator '$_accel'; using v5e's rate as a floor, not a real estimate" >&2
      : "${PRICE_PER_CHIP_HOUR_ONDEMAND:=1.20}"; : "${PRICE_PER_CHIP_HOUR_SPOT:=0.35}" ;;
  esac
  unset _accel
else
  : "${TP_SIZE:=1}"; : "${CHIPS:=1}"
  : "${PRICE_PER_CHIP_HOUR_ONDEMAND:=2.70}"; : "${PRICE_PER_CHIP_HOUR_SPOT:=0.81}"
fi

# --- Cost bookkeeping -------------------------------------------------------
# The tracked quantity is BILLED VM-HOURS, not benchmark-hours. A TPU VM bills
# while it exists, not while it computes. Headroom to the $1000 ceiling is
# roughly one forgotten VM-week.

# --- Where state lives ------------------------------------------------------
# Never leave results on the VM disk; the VM is deleted at the end of every
# session and re-created from scratch.
: "${GCS_BUCKET:=gs://${PROJECT}-bucketladder}"

# --- Model / serving --------------------------------------------------------
# Llama-3.1-8B-Instruct is on tpu-inference's fully-tested list; Gemma-3-4b is
# not (notes/prior_art.md, incidental finding). Gated repo — request access
# BEFORE provisioning, it is a common multi-hour stall.
: "${MODEL:=meta-llama/Llama-3.1-8B-Instruct}"
: "${TPU_INFERENCE_VERSION:=}"   # empty = latest; pin before any real run
